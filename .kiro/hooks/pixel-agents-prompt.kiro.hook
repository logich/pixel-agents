{
  "enabled": true,
  "name": "Pixel Agents: Prompt Start",
  "description": "Notifies Pixel Agents when a new prompt is submitted.",
  "version": "1",
  "when": {
    "type": "promptSubmit"
  },
  "then": {
    "type": "runCommand",
    "command": "PORT=$(cat ~/.pixel-agents/kiro-port 2>/dev/null) && [ -n \"$PORT\" ] && curl -sf -m 2 -X POST -H 'Content-Type: application/json' -d '{}' http://127.0.0.1:$PORT/prompt-start > /dev/null 2>&1 || true"
  }
}
