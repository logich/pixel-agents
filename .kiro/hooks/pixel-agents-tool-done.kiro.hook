{
  "enabled": true,
  "name": "Pixel Agents: Tool Done",
  "description": "Notifies Pixel Agents when a tool finishes executing.",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "read",
      "write",
      "shell"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "PORT=$(cat ~/.pixel-agents/kiro-port 2>/dev/null) && [ -n \"$PORT\" ] && curl -sf -m 2 -X POST -H 'Content-Type: application/json' -d \"{\\\"toolId\\\":\\\"$KIRO_TOOL_ID\\\"}\" http://127.0.0.1:$PORT/tool-done > /dev/null 2>&1 || true"
  }
}
