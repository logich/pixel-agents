{
  "enabled": true,
  "name": "Pixel Agents: Tool Start",
  "description": "Notifies Pixel Agents when a tool starts executing.",
  "version": "1",
  "when": {
    "type": "preToolUse",
    "toolTypes": [
      "read",
      "write",
      "shell"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "PORT=$(cat ~/.pixel-agents/kiro-port 2>/dev/null) && [ -n \"$PORT\" ] && TOOL_ID=$(curl -sf -m 2 -X POST -H 'Content-Type: application/json' -d \"{\\\"tool\\\":\\\"$KIRO_TOOL_NAME\\\"}\" http://127.0.0.1:$PORT/tool-start 2>/dev/null) || true"
  }
}
